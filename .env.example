# Search Grounding API Key
TAVILY_API_KEY=

# NVIDIA API Catalog inference key
NVIDIA_API_KEY=
LLM_PROVIDER=nvidia
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# Keep the quality-critical judge and final writer on the stronger model.
# IMPORTANT: Set JUDGE_MODEL to a DIFFERENT model than DRAFT_MODEL so the
# judge is an independent reviewer, not a self-grading system.
# Planning is compact, so it can use a faster endpoint.
FAST_MODEL=
PLAN_MODEL=
DRAFT_MODEL=
GEN_MODEL=
JUDGE_MODEL=
MAX_ATTEMPTS=3
# Seconds before a disabled Postgres pool is re-probed.
DB_RETRY_SECONDS=30
PROMPT_SOURCE_COUNT=3
PROMPT_SOURCE_CHARS=1200
PLAN_CACHE_DIR=cache/plans
DRAFT_MAX_TOKENS=4096
PLAN_MAX_TOKENS=1200
JUDGE_MAX_TOKENS=1800
NVIDIA_ENABLE_THINKING=false

# Optional alternative provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# LangSmith Tracing Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_AGENT_ID=your-comp
LANGSMITH_AGENT_ENVIRONMENT=local

# Optional semantic memory and audit persistence
DATABASE_URL=postgresql://learning_companion:local_dev_password@localhost:5432/learning_companion
DB_POOL_MAX_SIZE=3
DB_POOL_TIMEOUT_SECONDS=2
GEMINI_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_CALLS_PER_RUN=3
SEMANTIC_SIMILARITY_THRESHOLD=0.60
LLM_TOP_P=0.90

